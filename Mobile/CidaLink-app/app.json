{
  "expo": {
    "name": "CidaLink-App",
    "slug": "CidaLink-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoCida.png",
    "scheme": "cidalinkapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/LogoCida.png"
    },
    "android": {
      "package": "com.cidalink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LogoCida.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/LogoCida.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/LogoCida.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O CidaLink usa suas fotos para anexar à ocorrência.",
          "cameraPermission": "O CidaLink usa a câmera para fotografar a ocorrência."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CidaLink usa sua localização para marcar onde está a ocorrência."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "637ea728-4d9e-4bbe-bbcb-848732f9a6d1"
      }
    }
  }
}
